Options -Indexes
DirectoryIndex index.php our-company.php 404.php
RewriteEngine On
RewriteBase /aos/
#RewriteCond %{HTTP_HOST} !^localhost/oipa1$ [NC]
#RewriteRule ^(.*)$ http://localhost/oipa1/$1 [L,R=301]

<FilesMatch "\.(htaccess|htpasswd|ini|phps|fla|psd|log|sh)$">
 Order Allow,Deny
 Deny from all
</FilesMatch>

# stop hotlinking and serve alternate content
